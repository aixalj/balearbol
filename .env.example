# Airtable (server-only — set these in Vercel Project Settings)
# Table fields expected: Client Name, Phone Number, Email Address,
# Location Address, Specific Hazard Issue, Tree Documentation Image (attachment),
# Payment Status (Pending | Paid | Unpaid). Submission Date = Created time.
AIRTABLE_API_KEY=patXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Clients

# Cloudinary (cloud name + unsigned preset are public; put cloud name in js/config.js too)
# Create an unsigned upload preset named balearbol_uploads in Cloudinary Settings → Upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare Turnstile (secret only here / Vercel; site key goes in js/config.js)
# Dashboard: https://dash.cloudflare.com/ → Turnstile → Add widget
TURNSTILE_SECRET_KEY=0xXXXXXXXXXXXXXXXX

# Instagram Graph API (Business/Creator account + long-lived token)
# Set username in js/config.js as instagramUsername
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=me
